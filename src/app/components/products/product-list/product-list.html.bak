<!-- Modern Hero Section with Gradient -->
<div class="relative overflow-hidden bg-gradient-to-br from-brand-600 via-primary-600 to-secondary-600 min-h-screen">
  <!-- Animated Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <!-- Floating Gradient Orbs -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-brand-400 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob"></div>
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-secondary-400 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-2000"></div>
  <div class="absolute bottom-0 left-1/3 w-96 h-96 bg-primary-400 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-4000"></div>

  <!-- Hero Section -->
  <div class="relative">
    <div class="container mx-auto px-4 pt-8 pb-12">
      <!-- Breadcrumbs -->
      <nav class="breadcrumb-container mb-8 flex items-center space-x-2 text-sm text-white/80">
        <a href="/" class="hover:text-white transition-colors duration-200 flex items-center">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          หน้าแรก
        </a>
        <span class="text-white/60">/</span>
        <span class="text-white font-medium">สินค้า</span>
      </nav>

      <!-- Hero Content -->
      <div class="hero-content text-white mb-12">
        <div class="inline-block mb-4">
          <span class="px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full text-sm font-medium border border-white/20">
            {{ getTotalProductsText() }}
          </span>
        </div>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight">
          {{ pageTitle }}
        </h1>
        <p class="text-xl md:text-2xl text-white/90 max-w-2xl mb-8">
          ค้นพบสีคุณภาพพรีเมียม จากแบรนด์ชั้นนำ พร้อมส่งถึงมือคุณ
        </p>

        <!-- Active Filters Display -->
        @if (selectedCategoryId || selectedBrandId || searchQuery) {
          <div class="filter-chips flex flex-wrap gap-2 mb-6">
            @if (searchQuery) {
              <div class="filter-chip px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full text-sm font-medium border border-white/30 flex items-center">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                {{ searchQuery }}
                <button (click)="clearSearch()" class="ml-2 hover:bg-white/20 rounded-full p-0.5 transition-colors">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                  </svg>
                </button>
              </div>
            }
            @if (selectedCategoryId && getSelectedCategoryName()) {
              <div class="filter-chip px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full text-sm font-medium border border-white/30 flex items-center">
                หมวดหมู่: {{ getSelectedCategoryName() }}
                <button (click)="clearCategoryFilter()" class="ml-2 hover:bg-white/20 rounded-full p-0.5 transition-colors">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                  </svg>
                </button>
              </div>
            }
            @if (selectedBrandId && getSelectedBrandName()) {
              <div class="filter-chip px-4 py-2 bg-white/20 backdrop-blur-sm rounded-full text-sm font-medium border border-white/30 flex items-center">
                แบรนด์: {{ getSelectedBrandName() }}
                <button (click)="clearBrandFilter()" class="ml-2 hover:bg-white/20 rounded-full p-0.5 transition-colors">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                  </svg>
                </button>
              </div>
            }
            <button (click)="clearFilters()" class="px-4 py-2 bg-white text-brand-600 rounded-full text-sm font-medium hover:bg-white/90 transition-all duration-200 shadow-lg hover:shadow-xl">
              ล้างตัวกรองทั้งหมด
            </button>
          </div>
        }
      </div>
    </div>
  </div>

  <!-- Main Content Area -->
  <div class="relative bg-neutral-50 rounded-t-[3rem] shadow-2xl">
    <div class="container mx-auto px-4 py-12">
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Modern Filter Sidebar -->
        <aside class="lg:w-80 filter-sidebar">
          <div class="bg-white rounded-2xl shadow-xl border border-neutral-200 overflow-hidden sticky top-4">
            <!-- Filter Header -->
            <div class="bg-gradient-to-r from-brand-600 to-primary-600 px-6 py-5">
              <div class="flex items-center justify-between">
                <h2 class="text-xl font-bold text-white flex items-center">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                  </svg>
                  ตัวกรอง
                </h2>
                @if (selectedCategoryId || selectedBrandId) {
                  <button (click)="clearFilters()" class="text-sm text-white/90 hover:text-white bg-white/10 hover:bg-white/20 px-3 py-1 rounded-full transition-all duration-200 backdrop-blur-sm">
                    ล้างทั้งหมด
                  </button>
                }
              </div>
            </div>

            <div class="p-6">
              <!-- Sort Dropdown -->
              <div class="mb-8">
                <label class="block text-sm font-semibold text-neutral-700 mb-3 flex items-center">
                  <svg class="w-4 h-4 mr-2 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"></path>
                  </svg>
                  เรียงตาม
                </label>
                <div class="relative">
                  <select [(ngModel)]="sortBy" (change)="onSortChange()" class="w-full px-4 py-3 bg-gradient-to-br from-neutral-50 to-white border-2 border-neutral-200 rounded-xl appearance-none cursor-pointer focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all duration-200 font-medium text-neutral-700 hover:border-brand-300">
                    <option value="newest">ล่าสุด</option>
                    <option value="name-asc">ชื่อ (ก-ฮ)</option>
                    <option value="name-desc">ชื่อ (ฮ-ก)</option>
                    <option value="price-asc">ราคา (ต่ำ-สูง)</option>
                    <option value="price-desc">ราคา (สูง-ต่ำ)</option>
                  </select>
                  <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-brand-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </div>
                </div>
              </div>

              <!-- Category Filter -->
              <div class="mb-8">
                <h3 class="font-semibold text-neutral-800 mb-4 flex items-center text-base">
                  <svg class="w-4 h-4 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                  </svg>
                  หมวดหมู่
                </h3>
                <div class="space-y-2">
                  <label class="filter-option group flex items-center cursor-pointer p-3 rounded-xl hover:bg-gradient-to-r hover:from-brand-50 hover:to-primary-50 transition-all duration-200 border-2 border-transparent hover:border-brand-200" [class.active]="!selectedCategoryId">
                    <input
                      type="radio"
                      name="category"
                      [checked]="!selectedCategoryId"
                      (change)="filterByCategory()"
                      class="w-5 h-5 text-brand-600 focus:ring-brand-500 focus:ring-2 cursor-pointer"
                    />
                    <span class="ml-3 text-neutral-700 group-hover:text-brand-700 font-medium transition-colors">ทั้งหมด</span>
                    @if (!selectedCategoryId) {
                      <span class="ml-auto bg-brand-100 text-brand-700 text-xs px-2 py-1 rounded-full font-semibold">{{ products.length }}</span>
                    }
                  </label>
                  @for (category of categories; track category.id) {
                    <label class="filter-option group flex items-center cursor-pointer p-3 rounded-xl hover:bg-gradient-to-r hover:from-brand-50 hover:to-primary-50 transition-all duration-200 border-2 border-transparent hover:border-brand-200" [class.active]="selectedCategoryId === category.id">
                      <input
                        type="radio"
                        name="category"
                        [checked]="selectedCategoryId === category.id"
                        (change)="filterByCategory(category.id)"
                        class="w-5 h-5 text-brand-600 focus:ring-brand-500 focus:ring-2 cursor-pointer"
                      />
                      <span class="ml-3 text-neutral-700 group-hover:text-brand-700 font-medium transition-colors">{{ category.name }}</span>
                      @if (selectedCategoryId === category.id) {
                        <span class="ml-auto bg-brand-100 text-brand-700 text-xs px-2 py-1 rounded-full font-semibold">{{ products.length }}</span>
                      }
                    </label>
                  }
                </div>
              </div>

              <!-- Brand Filter -->
              <div>
                <h3 class="font-semibold text-neutral-800 mb-4 flex items-center text-base">
                  <svg class="w-4 h-4 mr-2 text-secondary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                  </svg>
                  แบรนด์
                </h3>
                <div class="space-y-2">
                  <label class="filter-option group flex items-center cursor-pointer p-3 rounded-xl hover:bg-gradient-to-r hover:from-secondary-50 hover:to-pink-50 transition-all duration-200 border-2 border-transparent hover:border-secondary-200" [class.active]="!selectedBrandId">
                    <input
                      type="radio"
                      name="brand"
                      [checked]="!selectedBrandId"
                      (change)="filterByBrand()"
                      class="w-5 h-5 text-secondary-600 focus:ring-secondary-500 focus:ring-2 cursor-pointer"
                    />
                    <span class="ml-3 text-neutral-700 group-hover:text-secondary-700 font-medium transition-colors">ทั้งหมด</span>
                    @if (!selectedBrandId) {
                      <span class="ml-auto bg-secondary-100 text-secondary-700 text-xs px-2 py-1 rounded-full font-semibold">{{ products.length }}</span>
                    }
                  </label>
                  @for (brand of brands; track brand.id) {
                    <label class="filter-option group flex items-center cursor-pointer p-3 rounded-xl hover:bg-gradient-to-r hover:from-secondary-50 hover:to-pink-50 transition-all duration-200 border-2 border-transparent hover:border-secondary-200" [class.active]="selectedBrandId === brand.id">
                      <input
                        type="radio"
                        name="brand"
                        [checked]="selectedBrandId === brand.id"
                        (change)="filterByBrand(brand.id)"
                        class="w-5 h-5 text-secondary-600 focus:ring-secondary-500 focus:ring-2 cursor-pointer"
                      />
                      <span class="ml-3 text-neutral-700 group-hover:text-secondary-700 font-medium transition-colors">{{ brand.name }}</span>
                      @if (selectedBrandId === brand.id) {
                        <span class="ml-auto bg-secondary-100 text-secondary-700 text-xs px-2 py-1 rounded-full font-semibold">{{ products.length }}</span>
                      }
                    </label>
                  }
                </div>
              </div>
            </div>
          </div>
        </aside>

        <!-- Products Grid -->
        <main class="flex-1">
          @if (loading) {
            <!-- Modern Loading State -->
            <div class="loading-container flex flex-col items-center justify-center py-32">
              <div class="relative mb-8">
                <!-- Animated Gradient Spinner -->
                <div class="w-20 h-20 border-8 border-neutral-200 rounded-full"></div>
                <div class="w-20 h-20 border-8 border-t-brand-600 border-r-primary-600 border-b-secondary-600 border-l-transparent rounded-full animate-spin absolute top-0 left-0"></div>

                <!-- Pulse Effect -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-12 h-12 bg-gradient-to-br from-brand-400 to-secondary-400 rounded-full animate-pulse"></div>
              </div>

              <h3 class="text-2xl font-bold text-neutral-800 mb-2">กำลังโหลดสินค้า...</h3>
              <p class="text-neutral-500">กรุณารอสักครู่</p>

              <!-- Loading Shimmer Cards -->
              <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 mt-12 w-full">
                @for (item of [1,2,3,4,5,6]; track item) {
                  <div class="bg-white rounded-2xl shadow-lg overflow-hidden animate-pulse">
                    <div class="h-64 bg-gradient-to-br from-neutral-200 to-neutral-300"></div>
                    <div class="p-6">
                      <div class="h-4 bg-neutral-200 rounded w-3/4 mb-3"></div>
                      <div class="h-6 bg-neutral-300 rounded w-1/2"></div>
                    </div>
                  </div>
                }
              </div>
            </div>
          } @else if (products.length === 0) {
            <!-- Premium Empty State -->
            <div class="empty-state bg-white rounded-3xl shadow-2xl p-16 text-center border border-neutral-200">
              <div class="max-w-md mx-auto">
                <!-- Beautiful Empty Illustration -->
                <div class="mb-8 relative">
                  <div class="w-32 h-32 mx-auto bg-gradient-to-br from-brand-100 to-secondary-100 rounded-full flex items-center justify-center">
                    <svg class="w-16 h-16 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                    </svg>
                  </div>
                  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-40 h-40 bg-brand-200 rounded-full filter blur-3xl opacity-30 -z-10"></div>
                </div>

                <h3 class="text-3xl font-bold text-neutral-800 mb-4">ไม่พบสินค้า</h3>
                <p class="text-lg text-neutral-600 mb-8">
                  @if (selectedCategoryId || selectedBrandId || searchQuery) {
                    ไม่พบสินค้าที่ตรงกับเงื่อนไขการค้นหา<br />ลองปรับเปลี่ยนตัวกรองเพื่อค้นหาสินค้าอื่น
                  } @else {
                    ขณะนี้ยังไม่มีสินค้าในระบบ<br />กรุณาลองใหม่อีกครั้งในภายหลัง
                  }
                </p>

                @if (selectedCategoryId || selectedBrandId || searchQuery) {
                  <button (click)="clearFilters()" class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-brand-600 to-primary-600 text-white font-semibold rounded-xl hover:from-brand-700 hover:to-primary-700 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    ล้างตัวกรองและดูสินค้าทั้งหมด
                  </button>
                }
              </div>
            </div>
          } @else {
            <!-- Products Grid -->
            <div class="products-grid-container">
              <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 lg:gap-8">
                @for (product of products; track product.id) {
                  <div class="product-card-wrapper">
                    <app-product-card [product]="product"></app-product-card>
                  </div>
                }
              </div>

              <!-- Pagination -->
              @if (totalPages > 1) {
                <div class="pagination-container mt-12 flex justify-center">
                  <div class="inline-flex items-center bg-white rounded-2xl shadow-xl border border-neutral-200 p-2">
                    <!-- Previous Button -->
                    <button
                      (click)="goToPage(currentPage - 1)"
                      [disabled]="currentPage === 1"
                      class="p-3 rounded-xl transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed hover:bg-gradient-to-r hover:from-brand-50 hover:to-primary-50 group">
                      <svg class="w-5 h-5 text-neutral-600 group-hover:text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                      </svg>
                    </button>

                    <!-- Page Numbers -->
                    <div class="flex items-center gap-1 mx-2">
                      @for (page of getPageNumbers(); track page) {
                        @if (page === '...') {
                          <span class="px-3 py-2 text-neutral-400">...</span>
                        } @else {
                          <button
                            (click)="goToPage(page)"
                            class="min-w-[2.75rem] px-3 py-2 rounded-xl font-semibold transition-all duration-200"
                            [class]="currentPage === page
                              ? 'bg-gradient-to-r from-brand-600 to-primary-600 text-white shadow-lg transform scale-105'
                              : 'text-neutral-600 hover:bg-neutral-100'">
                            {{ page }}
                          </button>
                        }
                      }
                    </div>

                    <!-- Next Button -->
                    <button
                      (click)="goToPage(currentPage + 1)"
                      [disabled]="currentPage === totalPages"
                      class="p-3 rounded-xl transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed hover:bg-gradient-to-r hover:from-brand-50 hover:to-primary-50 group">
                      <svg class="w-5 h-5 text-neutral-600 group-hover:text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                      </svg>
                    </button>
                  </div>
                </div>
              }
            </div>
          }
        </main>
      </div>
    </div>
  </div>
</div>
