<div class="min-h-screen bg-gradient-to-br from-purple-50 via-pink-50/30 to-indigo-50/30">
  @if (loading()) {
    <!-- Premium Loading State -->
    <div class="flex justify-center items-center py-32">
      <div class="relative">
        <div class="animate-spin rounded-full h-24 w-24 border-4 border-gradient-to-r from-purple-500 via-pink-500 to-indigo-500 border-t-transparent"></div>
        <div class="absolute top-0 left-0 animate-ping rounded-full h-24 w-24 border-4 border-purple-400 border-t-transparent opacity-20"></div>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-12 h-12 bg-gradient-to-br from-purple-600 to-pink-600 rounded-full animate-pulse"></div>
        </div>
      </div>
    </div>
  } @else if (product) {
    <div class="container mx-auto px-4 py-12">
      <!-- Breadcrumb -->
      <nav class="mb-8 breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm">
          <li>
            <a routerLink="/" class="text-gray-600 hover:text-purple-600 transition-colors">หน้าแรก</a>
          </li>
          <li class="text-gray-400">/</li>
          <li>
            <a routerLink="/products" class="text-gray-600 hover:text-purple-600 transition-colors">สินค้า</a>
          </li>
          <li class="text-gray-400">/</li>
          <li class="text-gray-900 font-medium">{{ product()!.name }}</li>
        </ol>
      </nav>

      <!-- Main Product Section -->
      <div class="grid lg:grid-cols-2 gap-12 mb-16">
        <!-- Left: Image Gallery -->
        <div class="product-gallery">
          <!-- Main Image Container with Glassmorphism -->
          <div class="main-image-container relative bg-white/80 backdrop-blur-xl rounded-3xl overflow-hidden border-2 border-white/50 shadow-2xl mb-6 group">
            <div class="aspect-square relative overflow-hidden bg-gradient-to-br from-gray-50 to-gray-100">
              <img
                [src]="getSelectedImage()"
                [alt]="product()!.name"
                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 ease-out"
              />

              <!-- Gradient Overlay on Hover -->
              <div class="absolute inset-0 bg-gradient-to-t from-purple-900/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

              <!-- Badges -->
              <div class="absolute top-6 left-6 flex flex-col gap-3 z-10 badges-container">
                @if (product.isNewArrival) {
                  <span class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-orange-500 to-pink-500 text-white rounded-full text-sm font-bold shadow-lg">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    สินค้าใหม่
                  </span>
                }
                @if (product.isBestseller) {
                  <span class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-purple-600 to-indigo-600 text-white rounded-full text-sm font-bold shadow-lg">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/>
                      <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/>
                    </svg>
                    ขายดี
                  </span>
                }
              </div>

              <!-- Wishlist Button -->
              <button class="absolute top-6 right-6 w-14 h-14 bg-white/90 backdrop-blur-md rounded-full flex items-center justify-center hover:bg-white hover:scale-110 transition-all duration-300 shadow-lg z-10 wishlist-btn group/wishlist">
                <svg class="w-6 h-6 text-pink-600 group-hover/wishlist:scale-125 transition-transform" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Thumbnail Gallery -->
          @if (product()!.images && product()!.images.length > 1) {
            <div class="thumbnail-gallery flex gap-4 overflow-x-auto pb-2">
              @for (image of product()!.images; track image.id) {
                <button
                  (click)="selectImage(image)"
                  [class.ring-4]="selectedImageId === image.id"
                  [class.ring-purple-600]="selectedImageId === image.id"
                  class="flex-shrink-0 w-24 h-24 rounded-2xl overflow-hidden bg-white border-2 border-gray-200 hover:border-purple-400 transition-all duration-300 hover:scale-105 transform"
                >
                  <img
                    [src]="image.imageUrl"
                    [alt]="image.altText || product()!.name"
                    class="w-full h-full object-cover"
                  />
                </button>
              }
            </div>
          }
        </div>

        <!-- Right: Product Info -->
        <div class="product-info">
          <!-- Brand -->
          @if (product()!.brand) {
            <div class="brand-badge inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-gray-100 to-gray-200 rounded-full text-sm font-semibold text-gray-700 mb-4">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              {{ product()!.brand.name }}
            </div>
          }

          <!-- Product Title -->
          <h1 class="product-title text-4xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-purple-900 via-pink-900 to-indigo-900 bg-clip-text text-transparent leading-tight">
            {{ product()!.name }}
          </h1>

          <!-- Rating and Reviews -->
          @if (product.averageRating && product.reviewCount) {
            <div class="rating-section flex items-center gap-4 mb-6">
              <div class="flex items-center gap-2">
                @for (star of getStarArray(product.averageRating || 0); track $index) {
                  @if (star) {
                    <svg class="w-6 h-6 text-yellow-400 fill-current" viewBox="0 0 20 20">
                      <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                    </svg>
                  } @else {
                    <svg class="w-6 h-6 text-gray-300 fill-current" viewBox="0 0 20 20">
                      <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                    </svg>
                  }
                }
              </div>
              <span class="text-lg font-bold text-gray-900">{{ product.averageRating }}</span>
              <span class="text-gray-500">({{ product.reviewCount }} รีวิว)</span>
            </div>
          }

          <!-- Price Section with Glassmorphism -->
          <div class="price-section bg-white/80 backdrop-blur-xl rounded-2xl p-6 border-2 border-white/50 shadow-xl mb-6">
            <div class="flex items-baseline gap-4">
              <span class="text-5xl font-bold bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">
                ฿{{ selectedVariant?.price?.toLocaleString() }}
              </span>
              @if (selectedVariant?.compareAtPrice && selectedVariant()?.compareAtPrice > selectedVariant()?.price) {
                <span class="text-2xl text-gray-400 line-through">
                  ฿{{ selectedVariant()?.compareAtPrice.toLocaleString() }}
                </span>
                <span class="px-3 py-1 bg-gradient-to-r from-red-500 to-pink-500 text-white rounded-full text-sm font-bold">
                  -{{ Math.round((((selectedVariant()?.compareAtPrice ?? 0) - (selectedVariant()?.price ?? 0)) / (selectedVariant()?.compareAtPrice ?? 1)) * 100) }}%
                </span>
              }
            </div>
          </div>

          <!-- Stock Status with Modern Badges -->
          <div class="stock-status mb-6">
            @if (isOutOfStock()) {
              <div class="bg-gradient-to-r from-red-500 to-pink-500 text-white rounded-2xl p-4 flex items-center gap-3">
                <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-lg">สินค้าหมด</h3>
                  <p class="text-sm opacity-90">ขออภัย สินค้าชิ้นนี้หมดชั่วคราว</p>
                </div>
              </div>
            } @else if (isLowStock()) {
              <div class="bg-gradient-to-r from-yellow-400 to-orange-400 text-white rounded-2xl p-4 flex items-center gap-3">
                <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-lg">สินค้าใกล้หมด!</h3>
                  <p class="text-sm opacity-90">เหลือเพียง {{ selectedVariant()?.stockQuantity }} ชิ้น</p>
                </div>
              </div>
            } @else {
              <div class="bg-gradient-to-r from-green-500 to-emerald-500 text-white rounded-2xl p-4 flex items-center gap-3">
                <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-lg">สินค้าพร้อมจัดส่ง</h3>
                  <p class="text-sm opacity-90">มีสินค้า {{ selectedVariant()?.stockQuantity }} ชิ้น</p>
                </div>
              </div>
            }
          </div>

          <!-- Short Description -->
          <p class="text-gray-600 text-lg mb-8 leading-relaxed">{{ product()!.shortDescription }}</p>

          <!-- Variant Selector -->
          @if (product()!.variants && (product()!.variants?.length ?? 0) > 1) {
            <div class="variant-section mb-8">
              <h3 class="text-lg font-bold text-gray-900 mb-4">เลือกขนาด</h3>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                @for (variant of product()!.variants; track variant.id) {
                  <button
                    (click)="selectVariant(variant)"
                    [disabled]="variant.stockQuantity <= 0"
                    [class.selected]="selectedVariant()?.id === variant.id && variant.stockQuantity > 0"
                    class="variant-btn relative px-6 py-4 rounded-xl border-2 transition-all duration-300 font-semibold"
                    [class.border-purple-600]="selectedVariant()?.id === variant.id && variant.stockQuantity > 0"
                    [class.bg-gradient-to-br]="selectedVariant()?.id === variant.id && variant.stockQuantity > 0"
                    [class.from-purple-50]="selectedVariant()?.id === variant.id && variant.stockQuantity > 0"
                    [class.to-pink-50]="selectedVariant()?.id === variant.id && variant.stockQuantity > 0"
                    [class.text-purple-900]="selectedVariant()?.id === variant.id && variant.stockQuantity > 0"
                    [class.border-gray-300]="selectedVariant()?.id !== variant.id && variant.stockQuantity > 0"
                    [class.hover:border-purple-400]="variant.stockQuantity > 0"
                    [class.bg-gray-100]="variant.stockQuantity <= 0"
                    [class.text-gray-400]="variant.stockQuantity <= 0"
                    [class.cursor-not-allowed]="variant.stockQuantity <= 0"
                  >
                    <!-- Color Swatch if available -->
                    @if (variant.colorCode) {
                      <div class="flex items-center gap-3">
                        <div
                          class="w-8 h-8 rounded-full border-2 border-white shadow-md"
                          [style.background-color]="variant.colorCode"
                        ></div>
                        <div class="text-left">
                          <div [class.line-through]="variant.stockQuantity <= 0">{{ variant.name }}</div>
                          @if (variant.stockQuantity <= 0) {
                            <span class="text-xs text-red-600 font-bold">หมด</span>
                          } @else if (variant.stockQuantity <= 5) {
                            <span class="text-xs text-orange-600">เหลือ {{ variant.stockQuantity }}</span>
                          }
                        </div>
                      </div>
                    } @else {
                      <div class="text-center">
                        <div [class.line-through]="variant.stockQuantity <= 0">{{ variant.name }}</div>
                        @if (variant.stockQuantity <= 0) {
                          <span class="text-xs text-red-600 font-bold mt-1 block">หมด</span>
                        } @else if (variant.stockQuantity <= 5) {
                          <span class="text-xs text-orange-600 mt-1 block">เหลือ {{ variant.stockQuantity }}</span>
                        }
                      </div>
                    }

                    <!-- Out of Stock Overlay -->
                    @if (variant.stockQuantity <= 0) {
                      <div class="absolute inset-0 flex items-center justify-center bg-gray-900/10 rounded-xl">
                        <span class="bg-red-500 text-white text-xs font-bold px-3 py-1 rounded-full">สินค้าหมด</span>
                      </div>
                    }

                    <!-- Selected Checkmark -->
                    @if (selectedVariant()?.id === variant.id && variant.stockQuantity > 0) {
                      <div class="absolute top-2 right-2 w-6 h-6 bg-gradient-to-br from-purple-600 to-pink-600 rounded-full flex items-center justify-center">
                        <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                      </div>
                    }
                  </button>
                }
              </div>
            </div>
          }

          <!-- Quantity Selector -->
          @if (!isOutOfStock()) {
            <div class="quantity-section mb-8">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-gray-900">จำนวน</h3>
                @if (selectedVariant() && (selectedVariant()?.stockQuantity ?? 0) > 0) {
                  <span class="text-sm font-semibold text-purple-600">
                    คงเหลือ: {{ selectedVariant()?.stockQuantity }} ชิ้น
                  </span>
                }
              </div>

              <div class="flex items-center gap-4 bg-white/80 backdrop-blur-xl rounded-2xl p-2 border-2 border-white/50 shadow-xl">
                <button
                  (click)="decrementQuantity()"
                  [disabled]="quantity() <= 1"
                  class="w-14 h-14 flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200 hover:from-purple-100 hover:to-pink-100 rounded-xl transition-all duration-300 disabled:opacity-30 disabled:cursor-not-allowed font-bold text-xl hover:scale-105 transform"
                >
                  −
                </button>

                <input
                  type="number"
                  [ngModel]="quantity()" (ngModelChange)="quantity.set($event)"
                  [min]="1"
                  [max]="getMaxQuantity()"
                  class="flex-1 text-center text-2xl font-bold bg-transparent border-none outline-none"
                />

                <button
                  (click)="incrementQuantity()"
                  [disabled]="quantity() >= getMaxQuantity()"
                  class="w-14 h-14 flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200 hover:from-purple-100 hover:to-pink-100 rounded-xl transition-all duration-300 disabled:opacity-30 disabled:cursor-not-allowed font-bold text-xl hover:scale-105 transform"
                >
                  +
                </button>
              </div>

              @if (quantity() >= getMaxQuantity()) {
                <p class="text-sm text-orange-600 mt-3 flex items-center gap-2">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                  </svg>
                  คุณเลือกสินค้าครบจำนวนที่มีในสต็อกแล้ว
                </p>
              }
            </div>
          }

          <!-- Add to Cart Button -->
          <button
            (click)="addToCart()"
            [disabled]="isOutOfStock()"
            class="add-to-cart-btn w-full py-5 rounded-2xl font-bold text-lg transition-all duration-300 transform hover:-translate-y-1 hover:shadow-2xl flex items-center justify-center gap-3 mb-6"
            [class.bg-gradient-to-r]="!isOutOfStock()"
            [class.from-purple-600]="!isOutOfStock()"
            [class.via-pink-600]="!isOutOfStock()"
            [class.to-indigo-600]="!isOutOfStock()"
            [class.text-white]="!isOutOfStock()"
            [class.hover:shadow-purple-500/50]="!isOutOfStock()"
            [class.bg-gray-400]="isOutOfStock()"
            [class.text-gray-200]="isOutOfStock()"
            [class.cursor-not-allowed]="isOutOfStock()"
          >
            @if (isOutOfStock()) {
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M13.477 14.89A6 6 0 015.11 6.524l8.367 8.368zm1.414-1.414L6.524 5.11a6 6 0 018.367 8.367zM18 10a8 8 0 11-16 0 8 8 0 0116 0z" clip-rule="evenodd"/>
              </svg>
              <span>สินค้าหมด</span>
            } @else {
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
              <span>เพิ่มเข้าตะกร้า</span>
            }
          </button>

          <!-- Quick Actions -->
          <div class="quick-actions grid grid-cols-2 gap-3">
            <button (click)="contactUs()" class="flex items-center justify-center gap-2 px-6 py-3 bg-white/80 backdrop-blur-xl border-2 border-gray-200 rounded-xl hover:border-purple-400 transition-all duration-300 font-semibold hover:shadow-lg">
              <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
              <span>สอบถาม</span>
            </button>

            <button (click)="shareProduct()" class="flex items-center justify-center gap-2 px-6 py-3 bg-white/80 backdrop-blur-xl border-2 border-gray-200 rounded-xl hover:border-pink-400 transition-all duration-300 font-semibold hover:shadow-lg">
              <svg class="w-5 h-5 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
              </svg>
              <span>แชร์</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Product Specifications Section -->
      @if (product()!.specifications || product()!.features || product()!.fullDescription) {
        <div class="specifications-section mb-16">
          <div class="bg-white/80 backdrop-blur-xl rounded-3xl border-2 border-white/50 shadow-2xl overflow-hidden">
            <!-- Tabs -->
            <div class="tabs-header flex border-b border-gray-200">
              <button
                (click)="activeTab.set('description')"
                [class.active]="activeTab() === 'description'"
                class="tab-btn flex-1 px-8 py-6 font-bold text-lg transition-all duration-300"
                [class.bg-gradient-to-r]="activeTab() === 'description'"
                [class.from-purple-50]="activeTab() === 'description'"
                [class.to-pink-50]="activeTab() === 'description'"
                [class.text-purple-900]="activeTab() === 'description'"
                [class.border-b-4]="activeTab() === 'description'"
                [class.border-purple-600]="activeTab() === 'description'"
                [class.text-gray-600]="activeTab() !== 'description'"
                [class.hover:bg-gray-50]="activeTab() !== 'description'"
              >
                รายละเอียด
              </button>

              @if (product()!.specifications) {
                <button
                  (click)="activeTab.set('specs')"
                  [class.active]="activeTab() === 'specs'"
                  class="tab-btn flex-1 px-8 py-6 font-bold text-lg transition-all duration-300"
                  [class.bg-gradient-to-r]="activeTab() === 'specs'"
                  [class.from-purple-50]="activeTab() === 'specs'"
                  [class.to-pink-50]="activeTab() === 'specs'"
                  [class.text-purple-900]="activeTab() === 'specs'"
                  [class.border-b-4]="activeTab() === 'specs'"
                  [class.border-purple-600]="activeTab() === 'specs'"
                  [class.text-gray-600]="activeTab() !== 'specs'"
                  [class.hover:bg-gray-50]="activeTab() !== 'specs'"
                >
                  ข้อมูลจำเพาะ
                </button>
              }

              @if (product()!.features && (product()!.features?.length ?? 0) > 0) {
                <button
                  (click)="activeTab.set('features')"
                  [class.active]="activeTab() === 'features'"
                  class="tab-btn flex-1 px-8 py-6 font-bold text-lg transition-all duration-300"
                  [class.bg-gradient-to-r]="activeTab() === 'features'"
                  [class.from-purple-50]="activeTab() === 'features'"
                  [class.to-pink-50]="activeTab() === 'features'"
                  [class.text-purple-900]="activeTab() === 'features'"
                  [class.border-b-4]="activeTab() === 'features'"
                  [class.border-purple-600]="activeTab() === 'features'"
                  [class.text-gray-600]="activeTab() !== 'features'"
                  [class.hover:bg-gray-50]="activeTab() !== 'features'"
                >
                  คุณสมบัติ
                </button>
              }
            </div>

            <!-- Tab Content -->
            <div class="tab-content p-8">
              @if (activeTab() === 'description' && product()!.fullDescription) {
                <div class="description-content prose max-w-none">
                  <p class="text-gray-700 text-lg leading-relaxed whitespace-pre-line">{{ product()!.fullDescription }}</p>
                </div>
              }

              @if (activeTab() === 'specs' && product()!.specifications) {
                <div class="specs-grid grid md:grid-cols-2 gap-4">
                  @for (spec of getSpecsArray(); track spec.key) {
                    <div class="spec-item flex items-start gap-4 p-4 bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl">
                      <div class="w-10 h-10 bg-gradient-to-br from-purple-600 to-pink-600 rounded-lg flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                      </div>
                      <div>
                        <dt class="text-sm font-semibold text-gray-500 mb-1">{{ spec.key }}</dt>
                        <dd class="text-lg font-bold text-gray-900">{{ spec.value }}</dd>
                      </div>
                    </div>
                  }
                </div>
              }

              @if (activeTab() === 'features' && product()!.features && (product()!.features?.length ?? 0) > 0) {
                <div class="features-list grid md:grid-cols-2 gap-4">
                  @for (feature of product()!.features; track $index) {
                    <div class="feature-item flex items-start gap-3 p-4 bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl">
                      <div class="w-8 h-8 bg-gradient-to-br from-purple-600 to-pink-600 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                        <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                      </div>
                      <p class="text-gray-700 font-medium leading-relaxed">{{ feature }}</p>
                    </div>
                  }
                </div>
              }
            </div>
          </div>
        </div>
      }

      <!-- Reviews Section -->
      <div class="reviews-section">
        <div class="bg-white/80 backdrop-blur-xl rounded-3xl border-2 border-white/50 shadow-2xl overflow-hidden">
          <!-- Reviews Header -->
          <div class="reviews-header flex items-center justify-between p-8 border-b border-gray-200">
            <div>
              <h2 class="text-3xl font-bold bg-gradient-to-r from-purple-900 to-pink-900 bg-clip-text text-transparent mb-3">
                รีวิวสินค้า
              </h2>
              @if (getApprovedReviews().length > 0) {
                <div class="flex items-center gap-4">
                  <div class="flex items-center gap-2">
                    @for (filled of getStarArray(getAverageRating()); track $index) {
                      @if (filled) {
                        <svg class="w-6 h-6 text-yellow-400 fill-current" viewBox="0 0 20 20">
                          <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                        </svg>
                      } @else {
                        <svg class="w-6 h-6 text-gray-300 fill-current" viewBox="0 0 20 20">
                          <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                        </svg>
                      }
                    }
                  </div>
                  <span class="text-2xl font-bold text-gray-900">{{ getAverageRating() }}</span>
                  <span class="text-gray-600">จาก {{ getApprovedReviews().length }} รีวิว</span>
                </div>
              }
            </div>

            @if (isAuthenticated) {
              <button
                (click)="openReviewForm()"
                class="px-8 py-4 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-xl font-bold hover:shadow-2xl hover:shadow-purple-500/50 transition-all duration-300 transform hover:-translate-y-1 flex items-center gap-3"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                </svg>
                <span>เขียนรีวิว</span>
              </button>
            }
          </div>

          <!-- Reviews Content -->
          <div class="reviews-content p-8">
            @if (loadingReviews()) {
              <div class="flex justify-center py-12">
                <div class="relative">
                  <div class="animate-spin rounded-full h-16 w-16 border-4 border-purple-600 border-t-transparent"></div>
                </div>
              </div>
            } @else if (getApprovedReviews().length === 0) {
              <!-- Empty State -->
              <div class="text-center py-16">
                <div class="w-32 h-32 bg-gradient-to-br from-purple-100 to-pink-100 rounded-full flex items-center justify-center mx-auto mb-6">
                  <svg class="w-16 h-16 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/>
                  </svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 mb-3">ยังไม่มีรีวิว</h3>
                <p class="text-gray-600 text-lg mb-6">เป็นคนแรกที่รีวิวสินค้านี้!</p>
                @if (isAuthenticated) {
                  <button
                    (click)="openReviewForm()"
                    class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-xl font-bold hover:shadow-2xl hover:shadow-purple-500/50 transition-all duration-300 transform hover:-translate-y-1"
                  >
                    เขียนรีวิวเลย
                  </button>
                }
              </div>
            } @else {
              <!-- Review Cards -->
              <div class="reviews-list grid gap-6">
                @for (review of getApprovedReviews(); track review.id) {
                  <app-review-card [review]="review"></app-review-card>
                }
              </div>
            }
          </div>
        </div>
      </div>
    </div>
  }
</div>

<!-- Review Form Modal -->
@if (showReviewForm() && product()) {
  <app-review-form
    [productId]="product()!.id"
    (reviewSubmitted)="onReviewSubmitted()"
    (formClosed)="closeReviewForm()"
  ></app-review-form>
}
